   "metadata": {},
   "source": [
    "## 3. Cleaning & standardisation\n",
    "\n",
    "Public datasets rarely use identical column names, so a small resolver maps whatever the file calls its columns onto a standard schema\n",
    "(`year, month, date, state, category, vehicle_class, vehicle_type, units`). If a required column cannot be found the error lists the\n",
    "columns that *are* available, so the mapping is easy to adjust."
   ]
  },
  {
   "cell_type": "code",
   "id": "13d4d28f",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def _key(s):\n",
    "    return re.sub(r\"[^a-z0-9]\", \"\", str(s).lower())\n",
    "\n",
    "def resolve(df, candidates, label, required=True):\n",
    "    \"\"\"Find the first column whose normalised name matches one of the candidates.\"\"\"\n",
    "    lookup = {_key(c): c for c in df.columns}\n",
    "    for cand in candidates:\n",
    "        if _key(cand) in lookup:\n",
    "            return lookup[_key(cand)]\n",
    "    if required:\n",
    "        raise KeyError(f\"No column found for '{label}'. Looked for {candidates}. Available columns: {list(df.columns)}\")\n",
    "    return None\n",
    "\n",
    "COLS = {\n",
    "    \"year\":     resolve(raw, [\"Year\"], \"year\"),\n",
    "    \"month\":    resolve(raw, [\"Month_Name\", \"Month\"], \"month\", required=False),\n",
    "    \"date\":     resolve(raw, [\"Date\"], \"date\", required=False),\n",
    "    \"state\":    resolve(raw, [\"State\"], \"state\"),\n",
    "    \"category\": resolve(raw, [\"Vehicle_Category\", \"Category\"], \"vehicle category\"),\n",
    "    \"vclass\":   resolve(raw, [\"Vehicle_Class\", \"Vehicle Class\"], \"vehicle class\", required=False),\n",
    "    \"vtype\":    resolve(raw, [\"Vehicle_Type\", \"Vehicle Type\"], \"vehicle type\", required=False),\n",
    "    \"units\":    resolve(raw, [\"EV_Sales_Quantity\", \"Sales_Quantity\", \"Quantity\", \"Sales\"], \"sales quantity\"),\n",
    "}\n",
    "print(\"Column mapping:\", COLS)\n",
    "\n",
    "# ---- Build the standardised frame ----\n",
    "year = pd.to_numeric(raw[COLS[\"year\"]], errors=\"coerce\")\n",
    "\n",
    "if COLS[\"date\"]:\n",
    "    date = pd.to_datetime(raw[COLS[\"date\"]], errors=\"coerce\")\n",
    "else:\n",
    "    date = pd.Series(pd.NaT, index=raw.index, dtype=\"datetime64[ns]\")\n",
    "if COLS[\"month\"] and date.isna().mean() > 0.5:          # fall back to year + month name\n",
    "    date = pd.to_datetime(year.astype(\"Int64\").astype(str) + \" \" + raw[COLS[\"month\"]].astype(str), errors=\"coerce\")\n",
    "\n",
    "ev = pd.DataFrame({\n",
    "    \"year\": year,\n",
    "    \"date\": date,\n",
    "    \"state\": raw[COLS[\"state\"]].astype(str).str.replace(r\"\\s+\", \" \", regex=True).str.strip(),\n",
    "    \"category\": raw[COLS[\"category\"]].astype(str).str.strip(),\n",
    "    \"vehicle_class\": raw[COLS[\"vclass\"]].astype(str).str.strip() if COLS[\"vclass\"] else \"\",\n",
    "    \"vehicle_type\": raw[COLS[\"vtype\"]].astype(str).str.strip() if COLS[\"vtype\"] else \"\",\n",
    "    \"units\": pd.to_numeric(raw[COLS[\"units\"]], errors=\"coerce\"),\n",
    "})\n",
    "ev[\"month\"] = ev[\"date\"].dt.month\n",
    "\n",
    "n_before = len(ev)\n",
    "ev = ev.dropna(subset=[\"year\", \"units\"])\n",
    "ev = ev[ev[\"units\"] >= 0].copy()\n",
    "ev[\"year\"] = ev[\"year\"].astype(int)\n",
    "has_monthly = ev[\"month\"].notna().mean() > 0.9\n",
    "\n",
    "print(f\"Rows kept: {len(ev):,} of {n_before:,}  |  duplicates (not removed): {ev.duplicated().sum():,}\")\n",
    "print(f\"Years: {ev['year'].min()}-{ev['year'].max()}  |  states/UTs: {ev['state'].nunique()}  |  monthly detail available: {has_monthly}\")\n",
    "print(\"\\nVehicle categories in the data (units):\")\n",
    "display(ev.groupby(\"category\")[\"units\"].sum().sort_values(ascending=False).to_frame(\"units\"))"
   ]
  },
  {
   "cell_type": "code",
   "id": "d55700ed",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# ---- Which years are complete? (partial years would distort YoY growth / CAGR) ----\n",
    "if has_monthly:\n",
    "    months_per_year = ev.groupby(\"year\")[\"month\"].nunique()\n",
    "    complete_years = sorted(months_per_year[months_per_year >= 12].index.tolist())\n",
    "    partial_years = sorted(set(ev[\"year\"]) - set(complete_years))\n",
    "else:\n",
    "    complete_years, partial_years = sorted(ev[\"year\"].unique().tolist()), []\n",
    "\n",
    "LATEST = complete_years[-1]\n",
    "print(f\"Complete years: {complete_years[0]}-{LATEST}  |  partial years (excluded from growth metrics): {partial_years or 'none'}\")\n",
    "\n",
    "# ---- Scope: 3-wheelers ----\n",
    "is_3w = ev[\"category\"].str.contains(r\"(?:^|\\D)3(?:\\D|$)|three\", case=False, regex=True, na=False)\n",
    "ev3w = ev[is_3w].copy()\n",
    "if ev3w.empty:\n",
    "    raise ValueError(f\"No 3-wheeler rows found. Categories present: {sorted(ev['category'].unique())}\")\n",
    "print(f\"3-wheeler categories matched: {sorted(ev3w['category'].unique())}  ->  {fmt_int(ev3w['units'].sum())} units in total\")\n",
    "\n",
    "# ---- Passenger vs. cargo (works off class/type text) ----\n",
    "def classify_3w(text):\n",
    "    s = str(text).upper()\n",
    "    if any(k in s for k in [\"GOODS\", \"(G)\", \"CART\", \"CARRIER\", \"LOADER\", \"CARGO\"]):\n",
    "        return \"Cargo\"\n",
    "    if any(k in s for k in [\"PASSENGER\", \"(P)\", \"RICKSHAW\", \"AUTO\", \"TAXI\"]):\n",
    "        return \"Passenger\"\n",
    "    return \"Other / unclassified\"\n",
    "\n",
    "ev3w[\"segment\"] = (ev3w[\"vehicle_class\"] + \" \" + ev3w[\"vehicle_type\"]).map(classify_3w)\n",
    "\n",
    "print(\"\\nHow raw vehicle classes were mapped to segments (check this!):\")\n",
    "mapping_check = (ev3w.assign(raw_label=(ev3w[\"vehicle_class\"] + \" | \" + ev3w[\"vehicle_type\"]).str.strip(\" |\"))\n",
    "                     .groupby([\"segment\", \"raw_label\"])[\"units\"].sum().sort_values(ascending=False))\n",
    "display(mapping_check.head(15).to_frame(\"units\"))"
   ]
  },
  {
