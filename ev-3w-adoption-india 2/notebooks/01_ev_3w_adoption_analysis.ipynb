    "## 2. Data acquisition (Kaggle)\n",
    "\n",
    "Data is pulled programmatically with [`kagglehub`](https://github.com/Kaggle/kagglehub) and cached in `data/raw/` (git-ignored, so the repo stays light and dataset licences are respected).\n",
    "\n",
    "* If `kagglehub` asksed for credentials, I ran `kagglehub.login()` once, or set the `KAGGLE_USERNAME` / `KAGGLE_KEY` environment variables."
    "* Downloaded the dataset page manually and dropped the CSV into `data/raw/<dataset-name>/`. The notebook will pick it up."
   ]
  },
  {
   "cell_type": "code",
   "id": "b8cde4fe",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def get_dataset(slug):\n",
    "    \"\"\"Return a local folder holding the dataset's CSVs.\n",
    "    Reuses data/raw/<name>/ if present, otherwise downloads via kagglehub.\"\"\"\n",
    "    target = RAW_DIR / slug.split(\"/\")[1]\n",
    "    if target.exists() and any(target.glob(\"*.csv\")):\n",
    "        print(f\"Using cached copy: {target.relative_to(ROOT)}\")\n",
    "        return target\n",
    "    try:\n",
    "        import kagglehub\n",
    "        src = Path(kagglehub.dataset_download(slug))\n",
    "        target.mkdir(parents=True, exist_ok=True)\n",
    "        for f in src.rglob(\"*.csv\"):\n",
    "            shutil.copy2(f, target / f.name)\n",
    "        print(f\"Downloaded {slug} -> {target.relative_to(ROOT)}\")\n",
    "        return target\n",
    "    except Exception as exc:\n",
    "        print(f\"[!] Could not download '{slug}' automatically ({type(exc).__name__}: {exc})\")\n",
    "        print(f\"    Download it manually from https://www.kaggle.com/datasets/{slug}\")\n",
    "        print(f\"    and place the CSV file(s) in: {target.relative_to(ROOT)}/\")\n",
    "        return None\n",
    "\n",
    "\n",
    "def read_largest_csv(folder):\n",
    "    csvs = sorted(Path(folder).glob(\"*.csv\"), key=lambda p: p.stat().st_size, reverse=True)\n",
    "    if not csvs:\n",
    "        raise FileNotFoundError(f\"No CSV files found in {folder}\")\n",
    "    return pd.read_csv(csvs[0]), csvs[0].name\n",
    "\n",
    "\n",
    "ev_dir = get_dataset(KAGGLE_EV_SALES)\n",
    "if ev_dir is None:\n",
    "    raise FileNotFoundError(\"EV sales dataset not available - see the message above.\")\n",
    "\n",
    "raw, fname = read_largest_csv(ev_dir)\n",
    "print(f\"Loaded {fname}: {raw.shape[0]:,} rows x {raw.shape[1]} columns\")\n",
    "raw.head()"
   ]
  },
  {
