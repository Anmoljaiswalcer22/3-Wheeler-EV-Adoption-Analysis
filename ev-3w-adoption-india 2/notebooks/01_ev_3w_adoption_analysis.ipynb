   "source": [
    "## 6. Geography — where is adoption happening?\n",
    "\n",
    "Adoption in a nascent market is rarely uniform. Two questions matter for a go-to-market plan: **which states carry the volume**, and **how concentrated** is it (a concentrated market is easier to enter but riskier to depend on)."
   ]
  },
  {
   "cell_type": "code",
   "id": "40cdf079",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "state_latest = ev3w[ev3w[\"year\"] == LATEST].groupby(\"state\")[\"units\"].sum().sort_values(ascending=False)\n",
    "state_cum = ev3w.groupby(\"state\")[\"units\"].sum().sort_values(ascending=False)\n",
    "\n",
    "state_tbl = pd.DataFrame({\"units_latest_year\": state_latest, \"units_cumulative\": state_cum}).fillna(0)\n",
    "state_tbl[\"share_latest_year\"] = state_tbl[\"units_latest_year\"] / state_tbl[\"units_latest_year\"].sum()\n",
    "state_tbl = state_tbl.sort_values(\"units_latest_year\", ascending=False)\n",
    "\n",
    "top5_share = state_tbl[\"share_latest_year\"].head(5).sum()\n",
    "hhi = (state_tbl[\"share_latest_year\"] ** 2).sum() * 10_000      # 10,000 = monopoly; <1,500 = unconcentrated\n",
    "\n",
    "top10 = state_tbl.head(10).iloc[::-1]\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "ax.barh(top10.index, top10[\"units_latest_year\"], color=\"#1f77b4\")\n",
    "for i, (u, s) in enumerate(zip(top10[\"units_latest_year\"], top10[\"share_latest_year\"])):\n",
    "    ax.text(u, i, f\"  {s:.0%}\", va=\"center\", fontsize=9)\n",
    "ax.set_title(f\"Top 10 states by electric 3W sales, {LATEST}\")\n",
    "ax.xaxis.set_major_formatter(mtick.FuncFormatter(lambda v, _: f\"{v/1000:,.0f}k\"))\n",
    "save_fig(\"05_top_states\")\n",
    "plt.show()\n",
    "\n",
