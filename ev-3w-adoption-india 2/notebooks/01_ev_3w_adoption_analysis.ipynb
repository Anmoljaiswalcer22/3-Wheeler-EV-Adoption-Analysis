    "import re\n",
    "import shutil\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mtick\n",
    "import seaborn as sns\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
    "plt.rcParams.update({\"figure.dpi\": 110, \"axes.titleweight\": \"bold\", \"axes.titlesize\": 12})\n",
    "\n",
    "# ---- Paths (works whether Jupyter is started from the repo root or from /notebooks) ----\n",
    "ROOT = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "RAW_DIR = ROOT / \"data\" / \"raw\"\n",
    "INTERVIEW_DIR = ROOT / \"data\" / \"interviews\"\n",
    "FIG_DIR = ROOT / \"reports\" / \"figures\"\n",
    "TABLE_DIR = ROOT / \"reports\" / \"tables\"\n",
    "for d in (RAW_DIR, INTERVIEW_DIR, FIG_DIR, TABLE_DIR):\n",
    "    d.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ---- Kaggle datasets used in this project ----\n",
    "KAGGLE_EV_SALES = \"mafzal19/electric-vehicle-sales-by-state-in-india\"                 # state x month x vehicle class EV sales\n",
    "KAGGLE_CHARGING = \"saketpradhan/electric-vehicle-charging-stations-in-india\"          # charging station locations (optional)\n",
    "\n",
    "def save_fig(name):\n",
    "    \"\"\"Save the current matplotlib figure into reports/figures (these PNGs are embedded in the README).\"\"\"\n",
    "    plt.savefig(FIG_DIR / f\"{name}.png\", bbox_inches=\"tight\", dpi=150)\n",
    "\n",
    "def fmt_int(x):\n",
    "    return f\"{x:,.0f}\"\n",
    "\n",
    "print(\"Project root:\", ROOT)"
   ]
