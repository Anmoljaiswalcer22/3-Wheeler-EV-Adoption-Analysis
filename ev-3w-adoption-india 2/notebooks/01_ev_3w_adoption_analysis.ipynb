print(f"{LATEST}: {fmt_int(annual_3w[LATEST])} electric 3W units")
print(f"CAGR {start_year}-{LATEST}: {cagr_3w:.1%}")
# ---- How big is the 3W slice of the whole EV market? ----
mix = ev.pivot_table(index="year", columns="category", values="units", aggfunc="sum", fill_value=0)
mix_share = mix.div(mix.sum(axis=1), axis=0)
