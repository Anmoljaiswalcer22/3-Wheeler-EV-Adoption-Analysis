## 6. Geography — where is adoption happening?

Adoption in a nascent market is rarely uniform. Two questions matter for a go-to-market plan: **which states carry the volume**, and **how concentrated** is it (a concentrated market is easier to enter but riskier to depend on).
state_latest = ev3w[ev3w["year"] == LATEST].groupby("state")["units"].sum().sort_values(ascending=False)
state_cum = ev3w.groupby("state")["units"].sum().sort_values(ascending=False)

state_tbl = pd.DataFrame({"units_latest_year": state_latest, "units_cumulative": state_cum}).fillna(0)
state_tbl["share_latest_year"] = state_tbl["units_latest_year"] / state_tbl["units_latest_year"].sum()
state_tbl = state_tbl.sort_values("units_latest_year", ascending=False)

top5_share = state_tbl["share_latest_year"].head(5).sum()
hhi = (state_tbl["share_latest_year"] ** 2).sum() * 10_000      # 10,000 = monopoly; <1,500 = unconcentrated

top10 = state_tbl.head(10).iloc[::-1]
fig, ax = plt.subplots(figsize=(9, 5))
ax.barh(top10.index, top10["units_latest_year"], color="#1f77b4")
for i, (u, s) in enumerate(zip(top10["units_latest_year"], top10["share_latest_year"])):
    ax.text(u, i, f"  {s:.0%}", va="center", fontsize=9)
ax.set_title(f"Top 10 states by electric 3W sales, {LATEST}")
ax.xaxis.set_major_formatter(mtick.FuncFormatter(lambda v, _: f"{v/1000:,.0f}k"))
save_fig("05_top_states")
plt.show()

print(f"Top-5 states = {top5_share:.0%} of {LATEST} electric 3W sales  |  HHI = {hhi:,.0f}")
display(state_tbl.head(10).style.format({"units_latest_year": "{:,.0f}", "units_cumulative": "{:,.0f}", "share_latest_year": "{:.1%}"}))
# ---- Momentum: state x year heatmap for the 12 largest states ----
recent_years = [y for y in complete_years if y >= LATEST - 5]
top12 = state_tbl.head(12).index
heat = (ev3w[ev3w["state"].isin(top12) & ev3w["year"].isin(recent_years)]
        .pivot_table(index="state", columns="year", values="units", aggfunc="sum", fill_value=0)
        .reindex(top12))

fig, ax = plt.subplots(figsize=(9, 5.5))
sns.heatmap(heat, annot=True, fmt=",.0f", cmap="Blues", cbar=False, linewidths=0.5, ax=ax)
ax.set_title("Electric 3W units by state and year (top 12 states)")
ax.set_xlabel(""); ax.set_ylabel("")
