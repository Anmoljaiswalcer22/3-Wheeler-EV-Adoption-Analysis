raw.head()
## 3. Cleaning & standardisation

Public datasets rarely use identical column names, so a small resolver maps whatever the file calls its columns onto a standard schema
(`year, month, date, state, category, vehicle_class, vehicle_type, units`). If a required column cannot be found the error lists the
columns that *are* available, so the mapping is easy to adjust.
def _key(s):
    return re.sub(r"[^a-z0-9]", "", str(s).lower())

def resolve(df, candidates, label, required=True):
    """Find the first column whose normalised name matches one of the candidates."""
    lookup = {_key(c): c for c in df.columns}
    for cand in candidates:
        if _key(cand) in lookup:
            return lookup[_key(cand)]
    if required:
        raise KeyError(f"No column found for '{label}'. Looked for {candidates}. Available columns: {list(df.columns)}")
    return None

COLS = {
    "year":     resolve(raw, ["Year"], "year"),
    "month":    resolve(raw, ["Month_Name", "Month"], "month", required=False),
    "date":     resolve(raw, ["Date"], "date", required=False),
    "state":    resolve(raw, ["State"], "state"),
    "category": resolve(raw, ["Vehicle_Category", "Category"], "vehicle category"),
    "vclass":   resolve(raw, ["Vehicle_Class", "Vehicle Class"], "vehicle class", required=False),
    "vtype":    resolve(raw, ["Vehicle_Type", "Vehicle Type"], "vehicle type", required=False),
    "units":    resolve(raw, ["EV_Sales_Quantity", "Sales_Quantity", "Quantity", "Sales"], "sales quantity"),
}
print("Column mapping:", COLS)

# ---- Build the standardised frame ----
year = pd.to_numeric(raw[COLS["year"]], errors="coerce")

if COLS["date"]:
    date = pd.to_datetime(raw[COLS["date"]], errors="coerce")
else:
    date = pd.Series(pd.NaT, index=raw.index, dtype="datetime64[ns]")
if COLS["month"] and date.isna().mean() > 0.5:          # fall back to year + month name
    date = pd.to_datetime(year.astype("Int64").astype(str) + " " + raw[COLS["month"]].astype(str), errors="coerce")

ev = pd.DataFrame({
    "year": year,
    "date": date,
    "state": raw[COLS["state"]].astype(str).str.replace(r"\s+", " ", regex=True).str.strip(),
    "category": raw[COLS["category"]].astype(str).str.strip(),
    "vehicle_class": raw[COLS["vclass"]].astype(str).str.strip() if COLS["vclass"] else "",
    "vehicle_type": raw[COLS["vtype"]].astype(str).str.strip() if COLS["vtype"] else "",
    "units": pd.to_numeric(raw[COLS["units"]], errors="coerce"),
})
ev["month"] = ev["date"].dt.month

n_before = len(ev)
ev = ev.dropna(subset=["year", "units"])
ev = ev[ev["units"] >= 0].copy()
ev["year"] = ev["year"].astype(int)
has_monthly = ev["month"].notna().mean() > 0.9

print(f"Rows kept: {len(ev):,} of {n_before:,}  |  duplicates (not removed): {ev.duplicated().sum():,}")
print(f"Years: {ev['year'].min()}-{ev['year'].max()}  |  states/UTs: {ev['state'].nunique()}  |  monthly detail available: {has_monthly}")
print("\nVehicle categories in the data (units):")
display(ev.groupby("category")["units"].sum().sort_values(ascending=False).to_frame("units"))
# ---- Which years are complete? (partial years would distort YoY growth / CAGR) ----
if has_monthly:
    months_per_year = ev.groupby("year")["month"].nunique()
    complete_years = sorted(months_per_year[months_per_year >= 12].index.tolist())
    partial_years = sorted(set(ev["year"]) - set(complete_years))
else:
    complete_years, partial_years = sorted(ev["year"].unique().tolist()), []

LATEST = complete_years[-1]
print(f"Complete years: {complete_years[0]}-{LATEST}  |  partial years (excluded from growth metrics): {partial_years or 'none'}")

# ---- Scope: 3-wheelers ----
is_3w = ev["category"].str.contains(r"(?:^|\D)3(?:\D|$)|three", case=False, regex=True, na=False)
ev3w = ev[is_3w].copy()
if ev3w.empty:
    raise ValueError(f"No 3-wheeler rows found. Categories present: {sorted(ev['category'].unique())}")
print(f"3-wheeler categories matched: {sorted(ev3w['category'].unique())}  ->  {fmt_int(ev3w['units'].sum())} units in total")

# ---- Passenger vs. cargo (works off class/type text; adjust keywords if your file labels them differently) ----
def classify_3w(text):
    s = str(text).upper()
    if any(k in s for k in ["GOODS", "(G)", "CART", "CARRIER", "LOADER", "CARGO"]):
        return "Cargo"
    if any(k in s for k in ["PASSENGER", "(P)", "RICKSHAW", "AUTO", "TAXI"]):
        return "Passenger"
    return "Other / unclassified"

ev3w["segment"] = (ev3w["vehicle_class"] + " " + ev3w["vehicle_type"]).map(classify_3w)

print("\nHow raw vehicle classes were mapped to segments (check this!):")
mapping_check = (ev3w.assign(raw_label=(ev3w["vehicle_class"] + " | " + ev3w["vehicle_type"]).str.strip(" |"))
                     .groupby(["segment", "raw_label"])["units"].sum().sort_values(ascending=False))
display(mapping_check.head(15).to_frame("units"))
## 4. Market structure — MECE segmentation

To size the opportunity without gaps or double counting, the Indian 3-wheeler market is broken into **Mutually Exclusive, Collectively Exhaustive** layers:

```
Indian 3-wheeler market
├── By powertrain ........ ICE (petrol / diesel / LPG) | CNG | Electric        <- this notebook sizes the Electric branch
│                                                                                 (ICE/CNG volumes need VAHAN data, see README)
└── Electric 3-wheelers
    ├── By use case ...... Passenger (shared autos, e-rickshaws) | Cargo (last-mile goods)
    ├── By geography ..... State / UT (36)
    └── By time .......... Year / month
```

Each layer is a partition: the segment totals below must add up to the total, which the notebook asserts.
seg_tbl = ev3w.groupby("segment")["units"].sum().sort_values(ascending=False).to_frame("units")
seg_tbl["share"] = seg_tbl["units"] / seg_tbl["units"].sum()

# MECE check: segments are exclusive and exhaustive -> shares add up to exactly 100 %
assert np.isclose(seg_tbl["share"].sum(), 1.0) and np.isclose(seg_tbl["units"].sum(), ev3w["units"].sum())

display(seg_tbl.style.format({"units": "{:,.0f}", "share": "{:.1%}"}))

seg_year = ev3w.pivot_table(index="year", columns="segment", values="units", aggfunc="sum", fill_value=0)
ax = seg_year.plot(kind="bar", stacked=True, figsize=(10, 4.5), width=0.8)
ax.set_title("Electric 3-wheeler sales by segment")
ax.set_xlabel("")
ax.set_ylabel("Units sold")
ax.yaxis.set_major_formatter(mtick.FuncFormatter(lambda v, _: f"{v/1000:,.0f}k"))
ax.legend(title="Segment", frameon=False)
plt.xticks(rotation=0)
save_fig("01_segments_by_year")
plt.show()
