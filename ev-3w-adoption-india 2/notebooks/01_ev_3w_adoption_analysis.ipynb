## 2. Data acquisition (Kaggle)

Data is pulled programmatically with [`kagglehub`](https://github.com/Kaggle/kagglehub) and cached in `data/raw/` (git-ignored, so the repo stays light and dataset licences are respected).

* If `kagglehub` asks for credentials, run `kagglehub.login()` once, or set the `KAGGLE_USERNAME` / `KAGGLE_KEY` environment variables. **Never commit `kaggle.json`.**
* If you have no internet access, download the dataset page manually and drop the CSV into `data/raw/<dataset-name>/`. The notebook will pick it up.
def get_dataset(slug):
    """Return a local folder holding the dataset's CSVs.
    Reuses data/raw/<name>/ if present, otherwise downloads via kagglehub."""
    target = RAW_DIR / slug.split("/")[1]
    if target.exists() and any(target.glob("*.csv")):
        print(f"Using cached copy: {target.relative_to(ROOT)}")
        return target
    try:
        import kagglehub
        src = Path(kagglehub.dataset_download(slug))
        target.mkdir(parents=True, exist_ok=True)
        for f in src.rglob("*.csv"):
            shutil.copy2(f, target / f.name)
        print(f"Downloaded {slug} -> {target.relative_to(ROOT)}")
        return target
    except Exception as exc:
        print(f"[!] Could not download '{slug}' automatically ({type(exc).__name__}: {exc})")
        print(f"    Download it manually from https://www.kaggle.com/datasets/{slug}")
        print(f"    and place the CSV file(s) in: {target.relative_to(ROOT)}/")
        return None


def read_largest_csv(folder):
    csvs = sorted(Path(folder).glob("*.csv"), key=lambda p: p.stat().st_size, reverse=True)
    if not csvs:
        raise FileNotFoundError(f"No CSV files found in {folder}")
    return pd.read_csv(csvs[0]), csvs[0].name


ev_dir = get_dataset(KAGGLE_EV_SALES)
if ev_dir is None:
    raise FileNotFoundError("EV sales dataset not available - see the message above.")

raw, fname = read_largest_csv(ev_dir)
