plt.show()
## 7. Charging infrastructure vs. adoption

*Optional.* Joins a Kaggle dataset of charging stations to state-level 3W sales. A rank correlation tells us whether states with more public charging also see higher adoption — **correlation, not causation**: 3-wheeler drivers often charge at home/depots, so public stations are only part of the story.
STATE_ALIASES = {"nctofdelhi": "delhi", "orissa": "odisha", "pondicherry": "puducherry", "uttaranchal": "uttarakhand",
                 "andamannicobarislands": "andamanandnicobarislands", "andamanandnicobar": "andamanandnicobarislands",
                 "dadraandnagarhavelianddamananddiu": "dadranagarhavelianddamandiu"}

def norm_state(s):
    k = re.sub(r"[^a-z0-9]", "", str(s).lower().replace("&", "and"))
    return STATE_ALIASES.get(k, k)

charging_rho, charging_p, charging_n = None, None, 0
try:
    ch_dir = get_dataset(KAGGLE_CHARGING)
    if ch_dir is None:
        raise FileNotFoundError("charging dataset unavailable")
    ch_raw, ch_name = read_largest_csv(ch_dir)
    ch_state_col = resolve(ch_raw, ["state", "State", "Region"], "state")

    stations = ch_raw.assign(key=ch_raw[ch_state_col].map(norm_state)).groupby("key").size().rename("stations")
    sales = state_tbl.assign(key=state_tbl.index.map(norm_state)).groupby("key")[["units_latest_year"]].sum()
    joined = sales.join(stations, how="inner")
    joined = joined[(joined["units_latest_year"] > 0) & (joined["stations"] > 0)]
    print(f"{ch_name}: {len(ch_raw):,} stations | states matched to sales data: {len(joined)} of {len(sales)}")

    from scipy.stats import spearmanr
    charging_rho, charging_p = spearmanr(joined["stations"], joined["units_latest_year"])
    charging_n = len(joined)

    fig, ax = plt.subplots(figsize=(7, 5))
    ax.scatter(joined["stations"], joined["units_latest_year"], s=45, alpha=0.8)
    ax.set_xscale("log"); ax.set_yscale("log")
    ax.set_xlabel("Public charging stations (log)")
    ax.set_ylabel(f"Electric 3W units sold, {LATEST} (log)")
    ax.set_title(f"Charging stations vs. 3W EV sales by state (Spearman rho = {charging_rho:.2f}, n = {charging_n})")
    save_fig("07_charging_vs_sales")
    plt.show()
except Exception as exc:
    print(f"Charging-infrastructure section skipped: {type(exc).__name__}: {exc}")
## 8. Unit economics — EV vs. CNG/ICE 3-wheeler

Adoption ultimately comes down to whether a driver earns more with an EV. This section models **annual running cost** and **payback period** on the higher upfront price.

> ⚠️ **The values below are illustrative placeholders, not sourced data.** Replace them with figures from OEM spec sheets, current fuel/electricity tariffs and, ideally, what drivers told you in interviews, and cite the source next to each one. The conclusions are only as good as these inputs, which is why the sensitivity table below matters more than the base case.
ASSUMPTIONS = {
    # --- usage ---
    "daily_km": 100,                 # km per day for a shared auto / e-rickshaw
    "days_per_year": 300,
    # --- vehicle prices (INR, ex-showroom, after any subsidy you want to include) ---
    "ev_price_inr": 350_000,
    "ice_price_inr": 280_000,
    # --- electric 3W ---
    "ev_kwh_per_km": 0.09,
    "electricity_inr_per_kwh": 10.0,
    "ev_maint_inr_per_km": 0.40,
    "battery_cost_inr": 120_000,
    "battery_life_years": 5,
    # --- CNG 3W ---
    "cng_price_inr_per_kg": 80.0,
    "cng_km_per_kg": 30.0,
    "ice_maint_inr_per_km": 1.00,
}

def tco(daily_km=None, cng_price=None, a=ASSUMPTIONS):
    daily_km = a["daily_km"] if daily_km is None else daily_km
    cng_price = a["cng_price_inr_per_kg"] if cng_price is None else cng_price
    km_year = daily_km * a["days_per_year"]
    ev_cost = km_year * (a["ev_kwh_per_km"] * a["electricity_inr_per_kwh"] + a["ev_maint_inr_per_km"]) \
              + a["battery_cost_inr"] / a["battery_life_years"]            # battery wear annualised
    ice_cost = km_year * (cng_price / a["cng_km_per_kg"] + a["ice_maint_inr_per_km"])
    savings = ice_cost - ev_cost
    premium = a["ev_price_inr"] - a["ice_price_inr"]
    payback = premium / savings if savings > 0 else np.inf
    return {"ev_cost": ev_cost, "ice_cost": ice_cost, "savings": savings, "premium": premium, "payback_years": payback}

base = tco()
print(f"Annual running cost  EV: INR {base['ev_cost']:,.0f}  |  CNG: INR {base['ice_cost']:,.0f}")
print(f"Annual saving with EV: INR {base['savings']:,.0f}  |  upfront premium: INR {base['premium']:,.0f}")
print(f"Payback on the price premium: {base['payback_years']:.1f} years")

# ---- Sensitivity: payback (years) vs. daily distance and CNG price ----
km_grid = [50, 70, 100, 130, 160]
cng_grid = [65, 75, 85, 95, 105]
sens = pd.DataFrame([[tco(k, p)["payback_years"] for k in km_grid] for p in cng_grid],
                    index=[f"INR {p}/kg" for p in cng_grid], columns=[f"{k} km/day" for k in km_grid])
sens_plot = sens.replace(np.inf, np.nan)

fig, ax = plt.subplots(figsize=(8, 4.2))
sns.heatmap(sens_plot, annot=True, fmt=".1f", cmap="RdYlGn_r", cbar_kws={"label": "payback (years)"}, linewidths=0.5, ax=ax)
ax.set_title("Payback on EV price premium - sensitivity to usage and CNG price")
ax.set_xlabel("Daily distance"); ax.set_ylabel("CNG price")
save_fig("08_payback_sensitivity")
plt.show()
## 9. Regulatory landscape

Policy is a first-order driver of 3W electrification in India. Document each instrument with its **level, mechanism, current status and source** — the table below lists the instruments to cover; fill in the details from the official notifications.

| Instrument | Level | What it does for 3W EVs | What to document (and cite) |
|---|---|---|---|
| **FAME India Phase II** | Central | Demand incentives (per-kWh subsidy) on registered E3Ws | Per-kWh rate over time, eligibility, end date |
| **PM E-DRIVE** (successor scheme) | Central | Continues central support for electric 3-wheelers and charging infrastructure | Eligible 3W categories (e-rickshaw / L5), incentive caps, validity period |
| **GST on EVs** | Central | EVs are taxed at a much lower GST rate than ICE vehicles | Current rate vs. ICE 3W |
| **PLI – Advanced Chemistry Cell (ACC)** | Central | Localised battery manufacturing to bring down pack costs | Scheme size, effect on battery pricing |
| **State EV policies** | State | Road-tax / registration waivers, additional purchase subsidies, charging incentives, permit rules for autos | Compare the top states identified in section 6 |
| **Permit & registration rules** | State / city | Permit caps for ICE autos; open or reserved permits for electric autos | Which top-state cities cap ICE auto permits |
| **Battery-swapping & charging standards** | Central | Interoperability, safety and tariff norms for charging | Status of swapping policy / standards |

> **Verify before publishing:** scheme details change frequently (rates, caps and end-dates are revised). Link each row to the primary government notification rather than a news article.
## 10. Driver interviews — barriers to adoption

The primary-research part of the project: **structured interviews with 3-wheeler drivers**, coded into barrier categories.

**Real interview data is not shipped with this repository.** The repo includes `data/interviews/interviews_synthetic_demo.csv`, a **randomly generated** dataset (20 fictional drivers) that exists only so this section runs end to end. Whenever it is used, every output is labelled *SYNTHETIC DEMO DATA* — it must not be read or presented as real findings.

To plug in your own coded interviews (these take priority over the demo file):

1. Copy `data/interviews/interview_template.csv` to `data/interviews/interviews_anonymized.csv` (one row per driver).
2. Mark each barrier the driver raised with `1` (otherwise `0`) in the `barrier_*` columns. Add or rename barrier columns freely — anything starting with `barrier_` is picked up.
3. **Remove all personal identifiers** (names, phone numbers, vehicle registration numbers) before the file goes anywhere near Git.

The cell below ranks barriers by how many drivers raised them and identifies the top challenges.
INTERVIEW_FILE = INTERVIEW_DIR / "interviews_anonymized.csv"       # your real, anonymised data (takes priority)
DEMO_FILE = INTERVIEW_DIR / "interviews_synthetic_demo.csv"         # randomly generated demo data
interviews, top_barriers, using_demo = None, None, False

if not INTERVIEW_FILE.exists() and DEMO_FILE.exists():
    INTERVIEW_FILE, using_demo = DEMO_FILE, True
    print("=" * 78)
    print("SYNTHETIC DEMO DATA: no real interview file found, using randomly generated rows.")
    print("These numbers are NOT findings. Add data/interviews/interviews_anonymized.csv to replace them.")
    print("=" * 78)

if INTERVIEW_FILE.exists():
    interviews = pd.read_csv(INTERVIEW_FILE)
    barrier_cols = [c for c in interviews.columns if c.startswith("barrier_")]
    truthy = {"1", "1.0", "yes", "y", "true"}
    flags = interviews[barrier_cols].apply(lambda s: s.astype(str).str.strip().str.lower().isin(truthy).astype(int))
    flags.columns = [c.replace("barrier_", "").replace("_", " ").capitalize() for c in flags.columns]   # readable labels

    n = len(interviews)
    prevalence = flags.mean().sort_values(ascending=False) * 100
    top_barriers = prevalence.head(2)

    fig, ax = plt.subplots(figsize=(8.5, 4.5))
    ax.barh(prevalence.index[::-1], prevalence.values[::-1], color="#ff7f0e")
    ax.set_xlabel(f"% of drivers raising the barrier (n = {n})")
    ax.set_title("Barriers to EV adoption - driver interviews" + ("  [SYNTHETIC DEMO DATA]" if using_demo else ""))
    ax.xaxis.set_major_formatter(mtick.PercentFormatter(decimals=0))
    save_fig("09_interview_barriers_demo" if using_demo else "09_interview_barriers")
    plt.show()

    print(f"Interviews analysed: {n}" + ("  (SYNTHETIC DEMO DATA)" if using_demo else ""))
    print("Top challenges:", "; ".join(f"{k} ({v:.0f}%)" for k, v in top_barriers.items()))

    if "ownership" in interviews.columns:        # owner-drivers vs. renters often face different barriers
        by_owner = (flags.groupby(interviews["ownership"]).mean().T * 100).reindex(prevalence.index)
        display(by_owner.round(0).style.format("{:.0f}%"))
else:
    print(f"No interview file found at {INTERVIEW_FILE.relative_to(ROOT)} - section skipped.")
    print("Template columns:", list(pd.read_csv(INTERVIEW_DIR / "interview_template.csv").columns)
          if (INTERVIEW_DIR / "interview_template.csv").exists() else "(template missing)")
## 11. Business models

Each recommended model should trace back to **a barrier found in section 10**, be **viable on the unit economics in section 8**, and be **deployable where adoption is concentrated (section 6)**. Replace the example archetypes below with the models from your own analysis.

