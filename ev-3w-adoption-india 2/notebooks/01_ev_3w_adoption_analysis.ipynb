annual_3w = ev3w.groupby("year")["units"].sum()
annual_all = ev.groupby("year")["units"].sum()

yoy = annual_3w.pct_change()
# YoY only meaningful between consecutive complete years
yoy = yoy[[y for y in yoy.index if y in complete_years and (y - 1) in complete_years]]

# CAGR over (up to) the last 5 complete years that have non-zero 3W sales
valid_years = [y for y in complete_years if annual_3w.get(y, 0) > 0]
